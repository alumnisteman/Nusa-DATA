generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  USER
  ADMIN
  MODERATOR
  ENTERPRISE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum ProfileType {
  PHK_RECOVERY
  RETIREMENT_SECOND_LIFE
  ACTIVE_PROFESSIONAL
  STUDENT
}

enum DataTrustLevel {
  SELF_DECLARED
  AI_ASSISTED
  EVIDENCE_ATTACHED
  HUMAN_VERIFIED
  OFFICIAL_PUBLIC
  LICENSED_PARTNER
}

enum SkillCategory {
  TECHNICAL
  MANAGERIAL
  INTERPERSONAL
  DOMAIN_SPECIFIC
  LANGUAGE
  CERTIFICATION
}

enum OpportunityType {
  JOB_EMPLOYMENT
  FREELANCE_PROJECT
  CONSULTING
  MENTORING
  TRAINING_DELIVERY
  KNOWLEDGE_ASSET
  AI_WORK_TASK
  BUSINESS_PARTNERSHIP
}

enum OpportunityStatus {
  DRAFT
  ACTIVE
  FILLED
  EXPIRED
  CANCELLED
}

enum RecoveryStatus {
  ASSESSMENT
  PLANNING
  IN_PROGRESS
  INCOME_ACHIEVED
  COMPLETED
}

enum TaskStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  DISPUTED
}

enum TransactionType {
  EARNING
  WITHDRAWAL
  REFUND
  BONUS
  PENALTY
  FEE
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum DataSourceType {
  BPS_API
  KEMNAKER_API
  BKN_SIASN
  OFFICIAL_PUBLIC
  LICENSED_PARTNER
  PARTNER_API
  USER_SUBMITTED
}

enum DataQualityStatus {
  RAW
  NORMALIZED
  VALIDATED
  APPROVED
  REJECTED
  STALE
}

enum ConsentType {
  DATA_PROCESSING
  MARKETING
  THIRD_PARTY_SHARING
  AI_TRAINING
  PROFILE_VISIBILITY
}

enum KnowledgeAssetType {
  SOP
  COURSE
  MENTORING_PACKAGE
  CONSULTING_PACKAGE
  BOOK
  TEMPLATE
  TRAINING_MODULE
  AI_KNOWLEDGE_ASSET
  CASE_STUDY
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  DATA_ACCESS
  EXPORT
  PAYMENT
}

// ==========================================
// USER & ORGANIZATION
// ==========================================

model User {
  id                String      @id @default(uuid())
  email             String      @unique
  passwordHash      String
  role              UserRole    @default(USER)
  status            UserStatus  @default(PENDING_VERIFICATION)
  profileType       ProfileType?
  fullName          String
  phone             String?
  avatarUrl         String?
  bio               String?
  regionProvince    String?
  regionCity        String?
  birthYear         Int?
  gender            String?
  emailVerifiedAt   DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  organization      Organization? @relation(fields: [organizationId], references: [id])
  organizationId    String?

  employmentHistory EmploymentHistory[]
  skills            UserSkill[]
  experiences       Experience[]
  evidences         Evidence[]
  workDNA           WorkDNA?
  assessments       Assessment[]
  phkProfile        PHKProfile?
  retirementProfile RetirementProfile?
  opportunities     Opportunity[]       @relation("PostedByUser")
  applications      OpportunityMatch[]  @relation("ApplicantUser")
  knowledgeAssets   KnowledgeAsset[]
  aiWorkTasks       AIWorkTask[]
  taskSubmissions   TaskSubmission[]
  wallet            Wallet?
  transactions      Transaction[]
  consents          Consent[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  recoveryPlans     RecoveryPlan[]

  @@map("users")
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  industry    String?
  size        String?
  website     String?
  logoUrl     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  opportunities Opportunity[]

  @@map("organizations")
}

// ==========================================
// EMPLOYMENT HISTORY
// ==========================================

model EmploymentHistory {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName     String
  position        String
  industry        String?
  startDate       DateTime
  endDate         DateTime?
  isCurrentJob    Boolean        @default(false)
  salaryMin       Int?
  salaryMax       Int?
  currency        String         @default("IDR")
  description     String?
  achievements    String?
  reasonForLeave  String?
  isPHKTermination Boolean       @default(false)
  phkDate         DateTime?
  phkSeverancePay Int?
  trustLevel      DataTrustLevel @default(SELF_DECLARED)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("employment_history")
}

// ==========================================
// SKILLS
// ==========================================

model Skill {
  id          String        @id @default(uuid())
  name        String        @unique
  category    SkillCategory
  description String?
  aliases     String[]
  demandScore Float?
  createdAt   DateTime      @default(now())

  userSkills  UserSkill[]

  @@map("skills")
}

model UserSkill {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId        String
  skill          Skill          @relation(fields: [skillId], references: [id])
  proficiencyLevel Int          @default(1) // 1–5
  yearsExperience Float?
  trustLevel     DataTrustLevel @default(SELF_DECLARED)
  lastVerifiedAt DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([userId, skillId])
  @@map("user_skills")
}

// ==========================================
// EXPERIENCE & EVIDENCE
// ==========================================

model Experience {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  category    String
  description String
  impact      String?
  startDate   DateTime?
  endDate     DateTime?
  trustLevel  DataTrustLevel @default(SELF_DECLARED)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  evidences   Evidence[]

  @@map("experiences")
}

model Evidence {
  id           String         @id @default(uuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  experienceId String?
  experience   Experience?    @relation(fields: [experienceId], references: [id])
  title        String
  type         String         // certificate, document, portfolio, url, media
  fileUrl      String?
  externalUrl  String?
  issuer       String?
  issuedAt     DateTime?
  expiresAt    DateTime?
  trustLevel   DataTrustLevel @default(SELF_DECLARED)
  verifiedAt   DateTime?
  verifiedBy   String?
  createdAt    DateTime       @default(now())

  @@map("evidences")
}

// ==========================================
// WORK DNA
// ==========================================

model WorkDNA {
  id                  String         @id @default(uuid())
  userId              String         @unique
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  coreStrengths       String[]
  workStyle           Json           // e.g. { "collaborative": 0.8, "autonomous": 0.6 }
  industryExpertise   String[]
  leadershipScore     Float?
  adaptabilityScore   Float?
  technicalDepth      Float?
  managementBreadth   Float?
  innovationIndex     Float?
  economicPotential   Json?          // estimated earning ranges by path
  careerPaths         Json[]         // computed recommended paths
  trustLevel          DataTrustLevel @default(AI_ASSISTED)
  lastComputedAt      DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@map("work_dna")
}

// ==========================================
// ASSESSMENT
// ==========================================

model Assessment {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // skill, personality, career_readiness, income_gap
  title       String
  responses   Json
  result      Json?
  score       Float?
  completedAt DateTime?
  createdAt   DateTime @default(now())

  @@map("assessments")
}

// ==========================================
// PHK RECOVERY ENGINE
// ==========================================

model PHKProfile {
  id                String         @id @default(uuid())
  userId            String         @unique
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  phkDate           DateTime
  lastCompany       String
  lastPosition      String
  lastSalary        Int?
  yearsOfService    Int?
  phkReason         String?
  currentStatus     RecoveryStatus @default(ASSESSMENT)
  targetMonthlyIncome Int?
  urgencyLevel      Int            @default(3) // 1-5
  financialRunway   Int?           // months of savings
  dependents        Int            @default(0)
  hasHealthInsurance Boolean       @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  recoveryPlans     RecoveryPlan[]

  @@map("phk_profiles")
}

model RecoveryPlan {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phkProfileId    String?
  phkProfile      PHKProfile? @relation(fields: [phkProfileId], references: [id])
  title           String
  targetIncome    Int
  timelineMonths  Int
  paths           Json[]   // Array of RecoveryPath objects
  currentPathIdx  Int      @default(0)
  milestones      Json[]
  status          RecoveryStatus @default(PLANNING)
  startedAt       DateTime?
  achievedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("recovery_plans")
}

// ==========================================
// RETIREMENT / SECOND LIFE ENGINE
// ==========================================

model RetirementProfile {
  id                    String   @id @default(uuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  retirementDate        DateTime?
  lastOrganization      String?
  lastPosition          String?
  totalYearsOfService   Int?
  pensionMonthlyAmount  Int?
  pensionProvider       String?  // TASPEN, ASABRI, BPJS
  targetSecondIncome    Int?
  healthStatus          String?
  availableHoursPerWeek Int?
  preferredWorkMode     String[] // remote, hybrid, onsite
  expertiseDomains      String[]
  knowledgeExtractionDone Boolean @default(false)
  secondLifeStatus      String   @default("ASSESSMENT")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("retirement_profiles")
}

// ==========================================
// OPPORTUNITY
// ==========================================

model Opportunity {
  id                String            @id @default(uuid())
  postedByUserId    String?
  postedByUser      User?             @relation("PostedByUser", fields: [postedByUserId], references: [id])
  organizationId    String?
  organization      Organization?     @relation(fields: [organizationId], references: [id])
  type              OpportunityType
  status            OpportunityStatus @default(DRAFT)
  title             String
  description       String
  requirements      String[]
  requiredSkills    String[]
  industry          String?
  location          String?
  isRemote          Boolean           @default(false)
  compensationMin   Int?
  compensationMax   Int?
  currency          String            @default("IDR")
  compensationType  String?           // monthly, project, hourly, revenue_share
  demandScore       Float?
  competitionLevel  String?           // LOW, MEDIUM, HIGH
  timeToFirstIncome Int?              // days
  confidenceScore   Float?
  expiresAt         DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  matches           OpportunityMatch[]

  @@map("opportunities")
}

model OpportunityMatch {
  id              String   @id @default(uuid())
  opportunityId   String
  opportunity     Opportunity @relation(fields: [opportunityId], references: [id])
  applicantUserId String
  applicantUser   User     @relation("ApplicantUser", fields: [applicantUserId], references: [id])
  matchScore      Float
  skillMatchPct   Float?
  status          String   @default("PENDING")
  appliedAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([opportunityId, applicantUserId])
  @@map("opportunity_matches")
}

// ==========================================
// KNOWLEDGE ASSET
// ==========================================

model KnowledgeAsset {
  id            String             @id @default(uuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          KnowledgeAssetType
  title         String
  description   String?
  contentUrl    String?
  priceIdr      Int?
  isFree        Boolean            @default(false)
  targetAudience String[]
  tags          String[]
  publishedAt   DateTime?
  viewCount     Int                @default(0)
  purchaseCount Int                @default(0)
  trustLevel    DataTrustLevel     @default(SELF_DECLARED)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@map("knowledge_assets")
}

// ==========================================
// AI WORK TASKS (NUSA Integration)
// ==========================================

model AIWorkTask {
  id              String     @id @default(uuid())
  assignedUserId  String?
  assignedUser    User?      @relation(fields: [assignedUserId], references: [id])
  title           String
  description     String
  category        String     // data_labeling, evaluation, translation, annotation, review
  requiredSkills  String[]
  compensationIdr Int
  estimatedHours  Float?
  deadline        DateTime?
  status          TaskStatus @default(PENDING)
  priority        Int        @default(3) // 1–5
  instructions    Json?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  submissions     TaskSubmission[]

  @@map("ai_work_tasks")
}

model TaskSubmission {
  id          String     @id @default(uuid())
  taskId      String
  task        AIWorkTask @relation(fields: [taskId], references: [id])
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  content     Json
  notes       String?
  status      TaskStatus @default(SUBMITTED)
  reviewNotes String?
  qualityScore Float?
  submittedAt DateTime   @default(now())
  reviewedAt  DateTime?

  qualityScores QualityScore[]

  @@map("task_submissions")
}

model QualityScore {
  id             String         @id @default(uuid())
  submissionId   String
  submission     TaskSubmission @relation(fields: [submissionId], references: [id])
  scorerType     String         // AI, HUMAN, EXPERT
  scorerUserId   String?
  accuracy       Float
  completeness   Float
  consistency    Float
  overall        Float
  feedback       String?
  scoredAt       DateTime       @default(now())

  @@map("quality_scores")
}

// ==========================================
// WALLET & TRANSACTIONS
// ==========================================

model Wallet {
  id            String        @id @default(uuid())
  userId        String        @unique
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  balanceIdr    Int           @default(0)
  pendingIdr    Int           @default(0)
  totalEarned   Int           @default(0)
  totalWithdrawn Int          @default(0)
  currency      String        @default("IDR")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  payouts       Payout[]

  @@map("wallets")
}

model Transaction {
  id              String            @id @default(uuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id])
  type            TransactionType
  status          TransactionStatus @default(PENDING)
  amountIdr       Int
  description     String?
  referenceId     String?           // task/opportunity/payout ID
  referenceType   String?
  metadata        Json?
  createdAt       DateTime          @default(now())
  completedAt     DateTime?

  @@map("transactions")
}

model Payout {
  id              String   @id @default(uuid())
  walletId        String
  wallet          Wallet   @relation(fields: [walletId], references: [id])
  amountIdr       Int
  method          String   // bank_transfer, gopay, ovo, dana
  accountNumber   String?
  accountName     String?
  bankCode        String?
  status          String   @default("PENDING")
  processedAt     DateTime?
  failureReason   String?
  createdAt       DateTime @default(now())

  @@map("payouts")
}

// ==========================================
// REAL DATA ENGINE
// ==========================================

model DataSource {
  id              String         @id @default(uuid())
  name            String         @unique
  type            DataSourceType
  description     String?
  baseUrl         String?
  authType        String?        // api_key, oauth, none
  licenseStatus   String?        // active, expired, pending
  licenseExpiry   DateTime?
  accessNote      String?
  isActive        Boolean        @default(true)
  lastFetchAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  ingestions      DataIngestion[]

  @@map("data_sources")
}

model DataIngestion {
  id              String            @id @default(uuid())
  sourceId        String
  source          DataSource        @relation(fields: [sourceId], references: [id])
  endpoint        String?
  parameters      Json?
  rawPayload      Json?
  status          DataQualityStatus @default(RAW)
  recordCount     Int               @default(0)
  errorMessage    String?
  period          String?           // e.g. "2024-Q1"
  fetchedAt       DateTime          @default(now())
  processedAt     DateTime?

  qualityRecords  DataQualityRecord[]

  @@map("data_ingestions")
}

model DataQualityRecord {
  id              String   @id @default(uuid())
  ingestionId     String
  ingestion       DataIngestion @relation(fields: [ingestionId], references: [id])
  fieldName       String
  issueType       String   // missing, format_error, outlier, duplicate
  issueDetail     String?
  rawValue        String?
  resolvedValue   String?
  resolvedAt      DateTime?
  createdAt       DateTime @default(now())

  @@map("data_quality_records")
}

// ==========================================
// AUDIT LOG
// ==========================================

model AuditLog {
  id          String      @id @default(uuid())
  userId      String?
  user        User?       @relation(fields: [userId], references: [id])
  action      AuditAction
  entity      String
  entityId    String?
  oldValues   Json?
  newValues   Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  @@map("audit_logs")
}

// ==========================================
// CONSENT
// ==========================================

model Consent {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        ConsentType
  granted     Boolean
  version     String      @default("1.0")
  grantedAt   DateTime?
  revokedAt   DateTime?
  ipAddress   String?
  createdAt   DateTime    @default(now())

  @@map("consents")
}

// ==========================================
// NOTIFICATION
// ==========================================

model Notification {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  title       String
  body        String
  data        Json?
  isRead      Boolean  @default(false)
  readAt      DateTime?
  createdAt   DateTime @default(now())

  @@map("notifications")
}
