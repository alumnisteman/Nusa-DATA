generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  USER
  ADMIN
  MODERATOR
  ENTERPRISE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum ProfileType {
  PHK_RECOVERY
  RETIREMENT_SECOND_LIFE
  ACTIVE_PROFESSIONAL
  STUDENT
}

enum DataTrustLevel {
  SELF_DECLARED
  AI_ASSISTED
  EVIDENCE_ATTACHED
  HUMAN_VERIFIED
  OFFICIAL_PUBLIC
  LICENSED_PARTNER
}

enum SkillCategory {
  TECHNICAL
  MANAGERIAL
  INTERPERSONAL
  DOMAIN_SPECIFIC
  LANGUAGE
  CERTIFICATION
}

enum OpportunityType {
  JOB_EMPLOYMENT
  FREELANCE_PROJECT
  CONSULTING
  MENTORING
  TRAINING_DELIVERY
  KNOWLEDGE_ASSET
  AI_WORK_TASK
  BUSINESS_PARTNERSHIP
}

enum OpportunityStatus {
  DRAFT
  ACTIVE
  FILLED
  EXPIRED
  CANCELLED
}

enum RecoveryStatus {
  ASSESSMENT
  PLANNING
  IN_PROGRESS
  INCOME_ACHIEVED
  COMPLETED
}

enum TaskStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  DISPUTED
}

enum TransactionType {
  EARNING
  WITHDRAWAL
  REFUND
  BONUS
  PENALTY
  FEE
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum DataSourceType {
  BPS_API
  KEMNAKER_API
  BKN_SIASN
  OFFICIAL_PUBLIC
  LICENSED_PARTNER
  PARTNER_API
  USER_SUBMITTED
}

enum DataQualityStatus {
  RAW
  NORMALIZED
  VALIDATED
  APPROVED
  REJECTED
  STALE
}

enum ConsentType {
  DATA_PROCESSING
  MARKETING
  THIRD_PARTY_SHARING
  AI_TRAINING
  PROFILE_VISIBILITY
}

enum KnowledgeAssetType {
  SOP
  COURSE
  MENTORING_PACKAGE
  CONSULTING_PACKAGE
  BOOK
  TEMPLATE
  TRAINING_MODULE
  AI_KNOWLEDGE_ASSET
  CASE_STUDY
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  DATA_ACCESS
  EXPORT
  PAYMENT
}

// ==========================================
// USER & ORGANIZATION
// ==========================================

model User {
  id              String       @id @default(uuid())
  email           String       @unique
  passwordHash    String
  role            UserRole     @default(USER)
  status          UserStatus   @default(PENDING_VERIFICATION)
  profileType     ProfileType?
  fullName        String
  phone           String?
  avatarUrl       String?
  bio             String?
  regionProvince  String?
  regionCity      String?
  birthYear       Int?
  gender          String?
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?

  employmentHistory EmploymentHistory[]
  skills            UserSkill[]
  experiences       Experience[]
  evidences         Evidence[]
  workDNA           WorkDNA?
  assessments       Assessment[]
  phkProfile        PHKProfile?
  retirementProfile RetirementProfile?
  opportunities     Opportunity[]       @relation("PostedByUser")
  applications      OpportunityMatch[]  @relation("ApplicantUser")
  knowledgeAssets   KnowledgeAsset[]
  aiWorkTasks       AIWorkTask[]
  taskSubmissions   TaskSubmission[]
  wallet            Wallet?
  transactions      Transaction[]
  consents          Consent[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  recoveryPlans        RecoveryPlan[]
  Subscription         Subscription[]
  customer             Customer?
  qualifications       Qualification[]
  assignedTasks        Assignment[]           @relation("AssignedWorker")
  marketplaceSubmissions MarketplaceSubmission[] @relation("SubmittedWorker")

  @@map("users")
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  industry    String?
  size        String?
  website     String?
  logoUrl     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users         User[]
  opportunities Opportunity[]
  customer      Customer?

  @@map("organizations")
}

// ==========================================
// EMPLOYMENT HISTORY
// ==========================================

model EmploymentHistory {
  id               String         @id @default(uuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName      String
  position         String
  industry         String?
  startDate        DateTime
  endDate          DateTime?
  isCurrentJob     Boolean        @default(false)
  salaryMin        Int?
  salaryMax        Int?
  currency         String         @default("IDR")
  description      String?
  achievements     String?
  reasonForLeave   String?
  isPHKTermination Boolean        @default(false)
  phkDate          DateTime?
  phkSeverancePay  Int?
  trustLevel       DataTrustLevel @default(SELF_DECLARED)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@map("employment_history")
}

// ==========================================
// SKILLS
// ==========================================

model Skill {
  id          String        @id @default(uuid())
  name        String        @unique
  category    SkillCategory
  description String?
  aliases     String[]
  demandScore Float?
  createdAt   DateTime      @default(now())

  userSkills UserSkill[]

  @@map("skills")
}

model UserSkill {
  id               String         @id @default(uuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId          String
  skill            Skill          @relation(fields: [skillId], references: [id])
  proficiencyLevel Int            @default(1) // 1–5
  yearsExperience  Float?
  trustLevel       DataTrustLevel @default(SELF_DECLARED)
  lastVerifiedAt   DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([userId, skillId])
  @@map("user_skills")
}

// ==========================================
// EXPERIENCE & EVIDENCE
// ==========================================

model Experience {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  category    String
  description String
  impact      String?
  startDate   DateTime?
  endDate     DateTime?
  trustLevel  DataTrustLevel @default(SELF_DECLARED)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  evidences Evidence[]

  @@map("experiences")
}

model Evidence {
  id           String         @id @default(uuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  experienceId String?
  experience   Experience?    @relation(fields: [experienceId], references: [id])
  title        String
  type         String // certificate, document, portfolio, url, media
  fileUrl      String?
  externalUrl  String?
  issuer       String?
  issuedAt     DateTime?
  expiresAt    DateTime?
  trustLevel   DataTrustLevel @default(SELF_DECLARED)
  verifiedAt   DateTime?
  verifiedBy   String?
  createdAt    DateTime       @default(now())

  @@map("evidences")
}

// ==========================================
// WORK DNA
// ==========================================

model WorkDNA {
  id                String         @id @default(uuid())
  userId            String         @unique
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  coreStrengths     String[]
  workStyle         Json // e.g. { "collaborative": 0.8, "autonomous": 0.6 }
  industryExpertise String[]
  leadershipScore   Float?
  adaptabilityScore Float?
  technicalDepth    Float?
  managementBreadth Float?
  innovationIndex   Float?
  economicPotential Json? // estimated earning ranges by path
  careerPaths       Json[] // computed recommended paths
  trustLevel        DataTrustLevel @default(AI_ASSISTED)
  lastComputedAt    DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@map("work_dna")
}

// ==========================================
// ASSESSMENT
// ==========================================

model Assessment {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String // skill, personality, career_readiness, income_gap
  title       String
  responses   Json
  result      Json?
  score       Float?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@map("assessments")
}

// ==========================================
// PHK RECOVERY ENGINE
// ==========================================

model PHKProfile {
  id                  String         @id @default(uuid())
  userId              String         @unique
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  phkDate             DateTime
  lastCompany         String
  lastPosition        String
  lastSalary          Int?
  yearsOfService      Int?
  phkReason           String?
  currentStatus       RecoveryStatus @default(ASSESSMENT)
  targetMonthlyIncome Int?
  urgencyLevel        Int            @default(3) // 1-5
  financialRunway     Int? // months of savings
  dependents          Int            @default(0)
  hasHealthInsurance  Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  recoveryPlans RecoveryPlan[]

  @@map("phk_profiles")
}

model RecoveryPlan {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  phkProfileId   String?
  phkProfile     PHKProfile?    @relation(fields: [phkProfileId], references: [id])
  title          String
  targetIncome   Int
  timelineMonths Int
  paths          Json[] // Array of RecoveryPath objects
  currentPathIdx Int            @default(0)
  milestones     Json[]
  status         RecoveryStatus @default(PLANNING)
  startedAt      DateTime?
  achievedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("recovery_plans")
}

// ==========================================
// RETIREMENT / SECOND LIFE ENGINE
// ==========================================

model RetirementProfile {
  id                      String    @id @default(uuid())
  userId                  String    @unique
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  retirementDate          DateTime?
  lastOrganization        String?
  lastPosition            String?
  totalYearsOfService     Int?
  pensionMonthlyAmount    Int?
  pensionProvider         String? // TASPEN, ASABRI, BPJS
  targetSecondIncome      Int?
  healthStatus            String?
  availableHoursPerWeek   Int?
  preferredWorkMode       String[] // remote, hybrid, onsite
  expertiseDomains        String[]
  knowledgeExtractionDone Boolean   @default(false)
  secondLifeStatus        String    @default("ASSESSMENT")
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@map("retirement_profiles")
}

// ==========================================
// OPPORTUNITY
// ==========================================

model Opportunity {
  id                String            @id @default(uuid())
  postedByUserId    String?
  postedByUser      User?             @relation("PostedByUser", fields: [postedByUserId], references: [id])
  organizationId    String?
  organization      Organization?     @relation(fields: [organizationId], references: [id])
  type              OpportunityType
  status            OpportunityStatus @default(DRAFT)
  title             String
  description       String
  requirements      String[]
  requiredSkills    String[]
  industry          String?
  location          String?
  isRemote          Boolean           @default(false)
  compensationMin   Int?
  compensationMax   Int?
  currency          String            @default("IDR")
  compensationType  String? // monthly, project, hourly, revenue_share
  demandScore       Float?
  competitionLevel  String? // LOW, MEDIUM, HIGH
  timeToFirstIncome Int? // days
  confidenceScore   Float?
  expiresAt         DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  matches OpportunityMatch[]

  @@map("opportunities")
}

model OpportunityMatch {
  id              String      @id @default(uuid())
  opportunityId   String
  opportunity     Opportunity @relation(fields: [opportunityId], references: [id])
  applicantUserId String
  applicantUser   User        @relation("ApplicantUser", fields: [applicantUserId], references: [id])
  matchScore      Float
  skillMatchPct   Float?
  status          String      @default("PENDING")
  appliedAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([opportunityId, applicantUserId])
  @@map("opportunity_matches")
}

// ==========================================
// KNOWLEDGE ASSET
// ==========================================

model KnowledgeAsset {
  id             String             @id @default(uuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           KnowledgeAssetType
  title          String
  description    String?
  contentUrl     String?
  priceIdr       Int?
  isFree         Boolean            @default(false)
  targetAudience String[]
  tags           String[]
  publishedAt    DateTime?
  viewCount      Int                @default(0)
  purchaseCount  Int                @default(0)
  trustLevel     DataTrustLevel     @default(SELF_DECLARED)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@map("knowledge_assets")
}

// ==========================================
// AI WORK TASKS (NUSA Integration)
// ==========================================

model AIWorkTask {
  id              String     @id @default(uuid())
  assignedUserId  String?
  assignedUser    User?      @relation(fields: [assignedUserId], references: [id])
  title           String
  description     String
  category        String // data_labeling, evaluation, translation, annotation, review
  requiredSkills  String[]
  compensationIdr Int
  estimatedHours  Float?
  deadline        DateTime?
  status          TaskStatus @default(PENDING)
  priority        Int        @default(3) // 1–5
  instructions    Json?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  submissions TaskSubmission[]

  @@map("ai_work_tasks")
}

// ==============================
// TASK (Buyer Evaluation)
// ==============================
model Task {
  id        String   @id @default(uuid())
  buyerId   String
  prompt    String
  modelAId  String?
  responseA String?
  modelBId  String?
  responseB String?
  category  String   @default("General")
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
}

model Model {
  id            String   @id @default(uuid())
  name          String
  provider      String
  scoreGlobal   Float
  scoreNatural  Float
  scoreCulture  Float
  scoreEmpathy  Float
  scoreRegional Float
  createdAt     DateTime @default(now())
}

model TaskSubmission {
  id            String         @id @default(uuid())
  aiWorkTaskId  String?
  aiWorkTask    AIWorkTask?    @relation(fields: [aiWorkTaskId], references: [id])
  contributorId String
  user          User           @relation(fields: [contributorId], references: [id])
  result        Json
  status        String         @default("SUBMITTED")
  submittedAt   DateTime       @default(now())
  qualityScores QualityScore[]
}

model Response {
  id            String   @id @default(uuid())
  taskId        String
  contributorId String
  preference    String
  earnedCents   Int      @default(0)
  createdAt     DateTime @default(now())
}

model QualityScore {
  id           String         @id @default(uuid())
  submissionId String
  submission   TaskSubmission @relation(fields: [submissionId], references: [id])
  scorerType   String // AI, HUMAN, EXPERT
  scorerUserId String?
  accuracy     Float
  completeness Float
  consistency  Float
  overall      Float
  feedback     String?
  scoredAt     DateTime       @default(now())

  @@map("quality_scores")
}

// ==========================================
// WALLET & TRANSACTIONS
// ==========================================

model Wallet {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balanceIdr     Int      @default(0)
  pendingIdr     Int      @default(0)
  totalEarned    Int      @default(0)
  totalWithdrawn Int      @default(0)
  currency       String   @default("IDR")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  payouts Payout[]

  @@map("wallets")
}

model Transaction {
  id            String            @id @default(uuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id])
  type          TransactionType
  status        TransactionStatus @default(PENDING)
  amountIdr     Int
  description   String?
  referenceId   String? // task/opportunity/payout ID
  referenceType String?
  metadata      Json?
  createdAt     DateTime          @default(now())
  completedAt   DateTime?

  @@map("transactions")
}

model Payout {
  id            String    @id @default(uuid())
  walletId      String
  wallet        Wallet    @relation(fields: [walletId], references: [id])
  amountIdr     Int
  method        String // bank_transfer, gopay, ovo, dana
  accountNumber String?
  accountName   String?
  bankCode      String?
  status        String    @default("PENDING")
  processedAt   DateTime?
  failureReason String?
  createdAt     DateTime  @default(now())

  @@map("payouts")
}

// ==========================================
// REAL DATA ENGINE
// ==========================================

model DataSource {
  id            String         @id @default(uuid())
  name          String         @unique
  type          DataSourceType
  description   String?
  baseUrl       String?
  authType      String? // api_key, oauth, none
  licenseStatus String? // active, expired, pending
  licenseExpiry DateTime?
  accessNote    String?
  isActive      Boolean        @default(true)
  lastFetchAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  ingestions DataIngestion[]

  @@map("data_sources")
}

model DataIngestion {
  id           String            @id @default(uuid())
  sourceId     String
  source       DataSource        @relation(fields: [sourceId], references: [id])
  endpoint     String?
  parameters   Json?
  rawPayload   Json?
  status       DataQualityStatus @default(RAW)
  recordCount  Int               @default(0)
  errorMessage String?
  period       String? // e.g. "2024-Q1"
  fetchedAt    DateTime          @default(now())
  processedAt  DateTime?

  qualityRecords DataQualityRecord[]

  @@map("data_ingestions")
}

model DataQualityRecord {
  id            String        @id @default(uuid())
  ingestionId   String
  ingestion     DataIngestion @relation(fields: [ingestionId], references: [id])
  fieldName     String
  issueType     String // missing, format_error, outlier, duplicate
  issueDetail   String?
  rawValue      String?
  resolvedValue String?
  resolvedAt    DateTime?
  createdAt     DateTime      @default(now())

  @@map("data_quality_records")
}

// ==========================================
// AUDIT LOG
// ==========================================

model AuditLog {
  id        String      @id @default(uuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id])
  action    AuditAction
  entity    String
  entityId  String?
  oldValues Json?
  newValues Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())

  @@map("audit_logs")
}

// ==========================================
// CONSENT
// ==========================================

model Consent {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ConsentType
  granted   Boolean
  version   String      @default("1.0")
  grantedAt DateTime?
  revokedAt DateTime?
  ipAddress String?
  createdAt DateTime    @default(now())

  @@map("consents")
}

// ==========================================
// NOTIFICATION
// ==========================================

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  data      Json?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("notifications")
}

// ================================
// NEW MODELS: Subscription, Billing, Human‑Task
// ================================

enum PlanType {
  FREE
  STARTER
  PRO
  BUSINESS
  ENTERPRISE
}

model Plan {
  id           String         @id @default(uuid())
  name         String
  priceCents   Int
  quota        Int // request quota per month
  limit        Int // hard limit per month
  type         PlanType       @default(FREE)
  productId    String?
  product      Product?       @relation(fields: [productId], references: [id])
  Subscription Subscription[]
  orderItems   OrderItem[]
}

model Subscription {
  id        String     @id @default(uuid())
  userId    String
  planId    String
  startDate DateTime   @default(now())
  endDate   DateTime?
  status    String     @default("ACTIVE")
  user      User       @relation(fields: [userId], references: [id])
  plan      Plan       @relation(fields: [planId], references: [id])
  ApiUsage  ApiUsage[]
}

model ApiUsage {
  id             String       @id @default(uuid())
  subscriptionId String
  endpoint       String
  method         String
  timestamp      DateTime     @default(now())
  count          Int          @default(1)
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
}

model HumanTask {
  id          String   @id @default(uuid())
  title       String
  description String
  rewardCents Int
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
}

model Contribution {
  id            String   @id @default(uuid())
  humanTaskId   String
  contributorId String
  result        Json
  rewardGiven   Boolean  @default(false)
  submittedAt   DateTime @default(now())
}

// ==========================================
// REVENUE CORE (Customer, Product, Order, Invoice)
// ==========================================

enum CustomerType {
  INDIVIDUAL
  ORGANIZATION
}

model Customer {
  id             String        @id @default(uuid())
  type           CustomerType  @default(INDIVIDUAL)
  userId         String?       @unique
  organizationId String?       @unique
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  billingEmail   String?
  billingAddress String?
  taxId          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  orders         Order[]
  invoices       Invoice[]
  projects       Project[]
  
  @@map("customers")
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  category    String   // e.g. "AI_TASK_MARKETPLACE", "DATA_INTELLIGENCE", "API"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  plans       Plan[]
  
  @@map("products")
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  FAILED
}

model Order {
  id          String       @id @default(uuid())
  customerId  String
  customer    Customer     @relation(fields: [customerId], references: [id])
  status      OrderStatus  @default(PENDING)
  totalCents  Int          @default(0)
  currency    String       @default("IDR")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  items       OrderItem[]
  invoices    Invoice[]
  
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  planId      String?
  plan        Plan?    @relation(fields: [planId], references: [id])
  quantity    Int      @default(1)
  unitPriceCents Int
  totalCents  Int
  description String?
  
  @@map("order_items")
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

model Invoice {
  id          String        @id @default(uuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id])
  customerId  String
  customer    Customer      @relation(fields: [customerId], references: [id])
  status      InvoiceStatus @default(DRAFT)
  invoiceNumber String      @unique
  subtotalCents Int
  taxCents      Int         @default(0)
  totalCents    Int
  currency      String      @default("IDR")
  dueDate       DateTime?
  paidAt        DateTime?
  pdfUrl        String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  payments      Payment[]
  
  @@map("invoices")
}

// ==========================================
// WEEK 2: PAYMENT & LEDGER
// ==========================================

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
}

enum PaymentMethod {
  BANK_TRANSFER
  QRIS
  CREDIT_CARD
  OVO
  GOPAY
  DANA
  VIRTUAL_ACCOUNT
}

model Payment {
  id              String        @id @default(uuid())
  invoiceId       String
  invoice         Invoice       @relation(fields: [invoiceId], references: [id])
  externalId      String        @unique  // ID dari payment gateway
  checkoutUrl     String?                // URL untuk diarahkan ke halaman bayar
  method          PaymentMethod?
  status          PaymentStatus @default(PENDING)
  amountCents     Int
  currency        String        @default("IDR")
  paidAt          DateTime?
  expiredAt       DateTime?
  gatewayResponse Json?         // raw response dari gateway (audit)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  ledgerEntries   LedgerEntry[]

  @@map("payments")
}

enum LedgerAccount {
  PLATFORM_REVENUE    // Akun pendapatan NUSA-DATA
  PLATFORM_FEE        // Komisi/fee NUSA-DATA
  WORKER_WALLET       // Dompet worker/kontributor
  CUSTOMER_PAYMENT    // Pembayaran dari customer
  REFUND_LIABILITY    // Kewajiban refund
  TAX_LIABILITY       // Kewajiban pajak
}

enum LedgerEntryType {
  DEBIT
  CREDIT
}

// LedgerEntry: double-entry bookkeeping — setiap transaksi menghasilkan
// minimal sepasang baris (Debit = Credit), tidak bisa dihapus.
model LedgerEntry {
  id          String           @id @default(uuid())
  paymentId   String?
  payment     Payment?         @relation(fields: [paymentId], references: [id])
  account     LedgerAccount
  type        LedgerEntryType
  amountCents Int
  currency    String           @default("IDR")
  description String?
  referenceId String?          // Order ID, Invoice ID, etc.
  createdAt   DateTime         @default(now())

  @@map("ledger_entries")
}

// ==========================================
// WEEK 3: MARKETPLACE
// (Project → Task → Qualification → Assignment → Submission)
// ==========================================

enum ProjectStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProjectTaskStatus {
  OPEN
  QUALIFICATION
  ASSIGNED
  IN_PROGRESS
  REVIEW
  DONE
  REJECTED
}

enum QualificationStatus {
  PENDING
  PASSED
  FAILED
}

enum AssignmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

enum MarketplaceSubmissionStatus {
  SUBMITTED
  ACCEPTED
  REVISION_REQUESTED
  REJECTED
}

// Project: satu project dari Customer (bisa punya banyak task)
model Project {
  id           String        @id @default(uuid())
  customerId   String
  customer     Customer      @relation(fields: [customerId], references: [id])
  title        String
  description  String
  requirements Json?         // array of strings
  budget       Int?          // total budget dalam cents
  currency     String        @default("IDR")
  deadline     DateTime?
  status       ProjectStatus @default(DRAFT)
  workerCount  Int           @default(0) // jumlah worker dibutuhkan
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tasks        ProjectTask[]

  @@map("projects")
}

// ProjectTask: unit pekerjaan terkecil dalam sebuah Project
model ProjectTask {
  id              String            @id @default(uuid())
  projectId       String
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  description     String
  instructions    Json?             // JSON panduan langkah demi langkah
  requiredSkills  String[]
  compensationCents Int             @default(0)
  deadline        DateTime?
  maxWorkers      Int               @default(1)
  status          ProjectTaskStatus @default(OPEN)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  qualifications  Qualification[]
  assignments     Assignment[]
  submissions     MarketplaceSubmission[]

  @@map("project_tasks")
}

// Qualification: hasil screening/uji kelayakan worker sebelum ditugaskan
model Qualification {
  id          String              @id @default(uuid())
  taskId      String
  task        ProjectTask         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workerId    String
  worker      User                @relation(fields: [workerId], references: [id])
  status      QualificationStatus @default(PENDING)
  score       Float?
  notes       String?
  screenedAt  DateTime?
  createdAt   DateTime            @default(now())

  @@unique([taskId, workerId])
  @@map("qualifications")
}

// Assignment: penugasan resmi worker ke sebuah task (setelah lolos kualifikasi)
model Assignment {
  id          String           @id @default(uuid())
  taskId      String
  task        ProjectTask      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workerId    String
  worker      User             @relation("AssignedWorker", fields: [workerId], references: [id])
  status      AssignmentStatus @default(ACTIVE)
  assignedAt  DateTime         @default(now())
  completedAt DateTime?

  @@unique([taskId, workerId])
  @@map("assignments")
}

// MarketplaceSubmission: hasil pekerjaan worker untuk sebuah task
model MarketplaceSubmission {
  id          String                      @id @default(uuid())
  taskId      String
  task        ProjectTask                 @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workerId    String
  worker      User                        @relation("SubmittedWorker", fields: [workerId], references: [id])
  result      Json                        // data hasil pekerjaan (bebas struktur per task)
  notes       String?
  status      MarketplaceSubmissionStatus @default(SUBMITTED)
  reviewNotes String?
  submittedAt DateTime                    @default(now())
  reviewedAt  DateTime?

  @@map("marketplace_submissions")
}


